#!/bin/bash
# Installer postinstall: install the HAL driver shipped inside the app with the same logic
# as the app's first-run assistant (Contents/Resources/install-driver.sh).
# $3 = target volume.
set -euo pipefail
TARGET="${3:-/}"
TARGET="${TARGET%/}"
APP="$TARGET/Applications/SoundRouter.app"
echo "SoundRouter postinstall: installing driver from $APP"
/bin/bash "$APP/Contents/Resources/install-driver.sh" "$APP/Contents/Resources/SoundRouter.driver"

# Restart an already-registered agent so it runs the new binary (no-op on first install).
CONSOLE_USER="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" && "$CONSOLE_USER" != "loginwindow" ]]; then
    UID_="$(id -u "$CONSOLE_USER")"
    /bin/launchctl kickstart -k "gui/$UID_/io.soundrouter.engine" >/dev/null 2>&1 || true
fi
exit 0
